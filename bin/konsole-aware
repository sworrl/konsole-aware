#!/usr/bin/env python3
"""Executable entrypoint for konsole-aware."""

import os
import sys
from pathlib import Path

# Add project root to sys.path so konsole_aware package can be imported
repo_root = Path(__file__).resolve().parent.parent
if str(repo_root) not in sys.path:
    sys.path.insert(0, str(repo_root))

from konsole_aware.cli import main

if __name__ == "__main__":
    sys.exit(main())
